# PelvIA Admin Panel - Environment Variables
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the backend API (must start with NEXT_PUBLIC_ to be accessible in the browser)
# Development: http://localhost:8000/api/v1
# Production:  https://api.pelvia.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
