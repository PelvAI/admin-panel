# ALMA Admin Panel - Environment Variables
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the Alma backend API (must start with NEXT_PUBLIC_ for the browser)
# Development: http://localhost:8001/api/v1
# Production:  https://api.alma.example/api/v1
#
# NEVER point this at the chatbot (:8000). Auth, RAG proxy and chat monitor
# all go through the Alma backend only.
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# ─── Auth (MVP notes) ─────────────────────────────────────────────────────────
# Login uses POST /auth/login with email + firebase_uid.
# admin@vela.com / admin@alma.com → Bearer test_uid_123 (dev seed UID).
# When the backend ships real staff auth, only lib/auth.ts + login need changes.
